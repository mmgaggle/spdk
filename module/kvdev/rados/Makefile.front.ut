#
# Standalone build for the Slice C4 front Mercury client core round-trip test.
# Not part of the SPDK build graph: it compiles the front client core
# (nkvx_front_client.c) + the C3 contract (nkvx_exec_rpc.c) directly against
# Mercury, proving the origin-side progress/forward/completion mechanism the
# SPDK poller will drive — with no SPDK reactor. The integrated front links the
# same nkvx_front_client.c into the rados module under CONFIG_MERCURY.
#
# Usage:
#   make -f Makefile.front.ut [MERCURY_PREFIX=<mercury-install>]   # build test
#   make -f Makefile.front.ut run                                  # build + loopback test
#   make -f Makefile.front.ut clean
# MERCURY_PREFIX defaults to the worktree's vendored install.

SPDK_ROOT       ?= $(realpath $(CURDIR)/../../..)
MERCURY_PREFIX  ?= $(SPDK_ROOT)/vendor/mercury-install

MERCURY_CFLAGS  := $(shell PKG_CONFIG_PATH=$(MERCURY_PREFIX)/lib/pkgconfig pkg-config --cflags mercury)
MERCURY_LIBS    := $(shell PKG_CONFIG_PATH=$(MERCURY_PREFIX)/lib/pkgconfig pkg-config --libs mercury)

# -std=gnu11 matches SPDK's build and is load-bearing for the C3 wire-status
# static-asserts (see nkvx_exec_rpc.c).
CFLAGS  := -g -O0 -std=gnu11 -Wall -Wextra -Werror -I$(SPDK_ROOT)/include $(MERCURY_CFLAGS)
# -lcrypto: the C7 driver sha256's the delivered result bytes to verify the bulk
# PUSH landed correctly (content-hash, design §1.3 NORMATIVE-ordering check).
LDFLAGS := $(MERCURY_LIBS) -lcrypto -Wl,-rpath,$(MERCURY_PREFIX)/lib

# Slice C8 (bead spdk-xmu.8): `make ASAN=1` instruments the FRONT driver
# (origin-side cancel/teardown) with AddressSanitizer too, so the abort path is
# ASan-clean on BOTH tiers (front + executor) under the C8 harness. Same caveat
# as the executor Makefile: the ASan and normal builds share the output path
# (nkvx_front_client_test), so they are not co-resident.
ifeq ($(ASAN),1)
CFLAGS  += -fsanitize=address -fno-omit-frame-pointer
LDFLAGS += -fsanitize=address
endif

BIN  := nkvx_front_client_test
SRCS := nkvx_front_client_test.c nkvx_front_client.c nkvx_exec_rpc.c
HDRS := nkvx_front_client.h nkvx_exec_rpc.h

$(BIN): $(SRCS) $(HDRS)
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LDFLAGS)

run: $(BIN)
	MERCURY_PREFIX=$(MERCURY_PREFIX) ./nkvx_front_test.sh

clean:
	rm -f $(BIN)

.PHONY: run clean
