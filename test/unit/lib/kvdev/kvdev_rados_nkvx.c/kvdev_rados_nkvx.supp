# ---------------------------------------------------------------------------
# 7. Syscall parameters that point at / contain uninitialised bytes. These are
#    the clone/futex/madvise/munmap/rt_sigprocmask issued by libwasmtime's rayon
#    thread pool and stack management. The uninitialised bytes are in glibc's /
#    wasmtime's own thread-management scratch, not in any nkvx-owned buffer.
# ---------------------------------------------------------------------------
{
   nkvx-syscall-clone-child-stack
   Memcheck:Param
   clone(child_stack)
   fun:clone
   fun:create_thread
   fun:pthread_create@@*
}
{
   nkvx-syscall-clone-tlsinfo
   Memcheck:Param
   clone(tlsinfo)
   fun:clone
   fun:create_thread
   fun:pthread_create@@*
}
{
   nkvx-syscall-futex-val
   Memcheck:Param
   futex(val)
   fun:__futex_abstimed_wait_common64
}
{
   nkvx-syscall-futex-futex
   Memcheck:Param
   futex(futex)
   fun:__futex_abstimed_wait_common64
}
{
   nkvx-syscall-madvise-start
   Memcheck:Param
   madvise(start)
   fun:madvise
   fun:advise_stack_range
   fun:start_thread
}
{
   nkvx-syscall-madvise-length
   Memcheck:Param
   madvise(length)
   fun:madvise
   fun:advise_stack_range
   fun:start_thread
}
{
   nkvx-syscall-munmap-start
   Memcheck:Param
   munmap(start)
   fun:munmap
   fun:__nptl_free_stacks
}
{
   nkvx-syscall-munmap-length
   Memcheck:Param
   munmap(length)
   fun:munmap
   fun:__nptl_free_stacks
}
{
   nkvx-syscall-rt-sigprocmask-set
   Memcheck:Param
   rt_sigprocmask(set)
   fun:start_thread
   fun:clone
}

# ---------------------------------------------------------------------------
# 8. Residual uninitialised-value reads whose ERROR SITE valgrind attributes to
#    an nkvx wasm-dispatch frame, but whose value --track-origins=yes proves was
#    created by wasmtime_longjmp/setjmp in libwasmtime.so (the JIT trampoline
#    poisons a stack slot the worker frame then reuses). These are pinned to the
#    wasm-ONLY worker dispatch chain (kvdev_rados_nkvx_wasm_run /
#    kvdev_rados_nkvx_worker_main / kvdev_rados_nkvx_complete_on_spdk, all of
#    which exist solely to run a wasm module off-reactor). A real nkvx uninit bug
#    on any OTHER code path has a different stack and is NOT covered here.
#
#    SOUNDNESS (spdk-pc0 fix loop, completed by spdk-5pq): the three over-broad
#    bare-nkvx blocks that used to live here --
#      nkvx-wasm-longjmp-taint-wasm-run-value
#      nkvx-wasm-longjmp-taint-wasm-run-cond
#      nkvx-wasm-longjmp-taint-worker-main-value
#    -- have been REMOVED. Their error stacks (fun:kvdev_rados_nkvx_wasm_run /
#    fun:kvdev_rados_nkvx_worker_main ... obj:*/libwasmtime.so) were byte-identical
#    to a real uninitialised-read bug at the top of those frames, so no scoping
#    could keep them from also hiding a genuine bug. The longjmp taint is now
#    cleared AT THE SOURCE -- a valgrind-only VALGRIND_MAKE_MEM_DEFINED right after
#    api->func_call returns in kvdev_rados_nkvx_wasm_run and on the reused worker-
#    loop locals in kvdev_rados_nkvx_worker_main (guarded by SPDK_UNIT_TEST so
#    production builds are byte-identical). With the taint gone the benign contexts
#    no longer fire, and a real uninitialised read at the top of either frame is
#    once again reported by Memcheck. The narrowly-pinned wasm-dispatch blocks
#    below (each anchored to a libwasmtime.so / libc / spdk_log frame, never a bare
#    nkvx top frame) remain, covering the residual cross-frame contexts.
# ---------------------------------------------------------------------------
{
   nkvx-wasm-longjmp-taint-trap-is-cap
   Memcheck:Value8
   fun:nkvx_wasm_trap_is_cap
   fun:kvdev_rados_nkvx_wasm_run
}
{
   nkvx-wasm-longjmp-taint-epoch-unregister
   Memcheck:Cond
   fun:nkvx_wasm_epoch_unregister
   fun:kvdev_rados_nkvx_wasm_run
}
{
   nkvx-wasm-longjmp-taint-worker-send-msg
   Memcheck:Cond
   fun:spdk_thread_send_msg
   fun:kvdev_rados_nkvx_worker_main
}
# spdk_thread_send_msg() reads tls_thread via _get_thread() to find the CURRENT
# SPDK thread. The off-reactor worker pthread is deliberately NOT an SPDK thread,
# so its tls_thread is never written (correctly NULL); Memcheck reports the read as
# uninitialised and misattributes its origin to the most recent stack allocation
# (the wasmtime longjmp). This is benign and inherent to dispatching the completion
# back with send_msg from a non-SPDK thread; it is the SPDK thread layer's read, not
# an nkvx one (top frame is fun:_get_thread inside lib/thread), and is pinned to the
# worker dispatch chain so it cannot match a real uninitialised read in nkvx code.
{
   nkvx-worker-send-msg-tls-thread-value
   Memcheck:Value8
   fun:_get_thread
   fun:spdk_thread_send_msg
   fun:kvdev_rados_nkvx_worker_main
}
{
   nkvx-wasm-longjmp-taint-complete-on-spdk
   Memcheck:Value8
   fun:kvdev_rados_nkvx_complete_on_spdk
   fun:msg_queue_run_batch
}
# libc free() of a wasmtime-owned pointer, branching on a longjmp-tainted value;
# pinned to the wasm_run dispatch frame directly below so it can only match the
# wasm teardown path, never a free() elsewhere in nkvx.
{
   nkvx-wasm-longjmp-taint-free-in-wasm-run
   Memcheck:Cond
   fun:free
   fun:kvdev_rados_nkvx_wasm_run
}
{
   nkvx-wasm-longjmp-taint-free-value-in-wasm-run
   Memcheck:Value8
   fun:free
   fun:kvdev_rados_nkvx_wasm_run
}
# The SPDK-thread completion frees the job struct whose status/result fields came
# back wasmtime-tainted from the worker. Pinned to the dispatch path so it only
# matches the wasm completion, not a free() elsewhere on the SPDK thread.
{
   nkvx-wasm-longjmp-taint-free-in-msg-queue
   Memcheck:Cond
   fun:free
   fun:msg_queue_run_batch
   fun:thread_poll
   fun:spdk_thread_poll
   fun:poll_thread
   fun:poll_threads
   fun:dispatch_and_wait
}
{
   nkvx-wasm-longjmp-taint-complete-on-spdk-direct
   Memcheck:Value8
   fun:kvdev_rados_nkvx_complete_on_spdk
   fun:msg_queue_run_batch
   fun:thread_poll
   fun:spdk_thread_poll
   fun:poll_thread
   fun:poll_threads
   fun:dispatch_and_wait
}
# spdk_log() / its vsnprintf+memcpy path invoked from the wasm trap classifier or
# wasm_run to log a trap; the format argument carries the longjmp-tainted value.
# Pinned to the wasm dispatch chain below the libc/spdk_log frames so it cannot
# match a log call on any non-wasm path.
{
   nkvx-wasm-longjmp-taint-spdk-vlog-trap-is-cap
   Memcheck:Cond
   fun:spdk_vlog
   fun:spdk_log
   fun:nkvx_wasm_trap_is_cap
   fun:kvdev_rados_nkvx_wasm_run
}
{
   nkvx-wasm-longjmp-taint-spdk-vlog-in-wasm-run
   Memcheck:Cond
   fun:spdk_vlog
   fun:spdk_log
   fun:kvdev_rados_nkvx_wasm_run
}
{
   nkvx-wasm-longjmp-taint-printf-memmove-in-wasm-run
   Memcheck:Cond
   fun:is_overlap
   fun:is_overlap
   fun:memmove
   ...
   fun:spdk_vlog
   fun:spdk_log
   ...
   fun:kvdev_rados_nkvx_wasm_run
}

# ---------------------------------------------------------------------------
# 8b. wasmtime JIT-compiled wasm code (anonymous mmap, no symbol -> "???")
#     deliberately faulting. The negative TB tests (oob.wasm, overalloc.wasm,
#     slackwrite.wasm, pageprobe.wasm) intentionally make the module touch a
#     guard page; wasmtime catches it via its setjmp/longjmp trap handler. The
#     "Invalid write/read" at the ??? JIT frame is that guarded fault, reached
#     only through wasmtime_setjmp / wasmtime_func_call. Pinned to the wasmtime
#     trampoline frames so it cannot match a stray bad access in real code.
# ---------------------------------------------------------------------------
{
   nkvx-wasmtime-jit-guarded-fault-addr1-write
   Memcheck:Addr1
   obj:*
   obj:*
   fun:wasmtime_setjmp*
}
{
   nkvx-wasmtime-jit-guarded-fault-addr1-read
   Memcheck:Addr1
   obj:*
   fun:wasmtime_setjmp*
}
{
   nkvx-wasmtime-jit-guarded-fault-value
   Memcheck:Value8
   obj:*
   fun:wasmtime_setjmp*
}

# ---------------------------------------------------------------------------
# 9. "Possibly lost" leaks. (a) libwasmtime's rayon global thread pool, never
#    torn down (a one-time process-wide pool). (b) the nkvx wasm epoch ticker:
#    a single intentionally-detached daemon thread (for(;;) loop, never joined by
#    design) -- the "leaked" block is glibc's thread DTV/TLS (allocate_dtv /
#    _dl_allocate_tls / pthread_create), not an nkvx heap allocation. Both are
#    pinned to glibc's pthread_create TLS allocator below them, so a genuine
#    nkvx heap leak (malloc/calloc with an nkvx allocation site) is NOT matched.
# ---------------------------------------------------------------------------
{
   nkvx-wasmtime-rayon-threadpool-leak
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@*
   ...
   obj:*/libwasmtime.so
}
# The leaked block is glibc's thread DTV/TLS (calloc -> allocate_dtv ->
# _dl_allocate_tls -> allocate_stack -> pthread_create), NOT an nkvx heap object.
# Require that EXACT glibc TLS-allocator chain ABOVE nkvx_wasm_epoch_register, and
# pin the wasm-only dispatch chain BELOW it. A real nkvx heap leak whose allocation
# site is nkvx_wasm_epoch_register (e.g. malloc/calloc of an nkvx struct) has the
# nkvx malloc/calloc frame directly above epoch_register -- NOT the _dl_allocate_tls
# DTV chain -- and so does NOT match. A genuine TLS leak from an epoch thread spawned
# on any non-wasm path also fails to match (no wasm_run/worker_main below).
{
   nkvx-wasm-epoch-ticker-thread-tls-leak
   Memcheck:Leak
   match-leak-kinds: possible
   fun:calloc
   fun:calloc
   fun:allocate_dtv
   fun:_dl_allocate_tls
   fun:allocate_stack
   fun:pthread_create@@*
   fun:nkvx_wasm_epoch_register
   fun:kvdev_rados_nkvx_wasm_run
   fun:kvdev_rados_nkvx_run_module
   fun:kvdev_rados_nkvx_worker_main
   fun:start_thread
   fun:clone
}
