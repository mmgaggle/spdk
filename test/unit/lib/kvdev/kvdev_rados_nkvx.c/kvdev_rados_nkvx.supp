# Valgrind suppressions for the kvdev_rados_nkvx unit test (spdk-pc0).
#
# This UT links the rados-nkvx wasm executor and, when SPDK is built --with-wasm,
# dlopen()s the third-party libwasmtime.so to run real .wasm modules off-reactor.
# Wasmtime is a JIT: it uses setjmp/longjmp trampolines, a rayon thread pool, a
# libgcc DWARF-unwind frame registry (btree), and per-thread TLS/stack churn.
# Under Memcheck this produces ~2100 uninitialised-value contexts plus two
# "possibly lost" thread-pool/ticker allocations. Every one was confirmed with
# --track-origins=yes to ORIGINATE in libwasmtime.so / libgcc_s / glibc, NOT in
# nkvx code (origin frame is always wasmtime_longjmp / rayon / a libgcc btree /
# a glibc TLS allocator).
#
# SCOPING GUARANTEE: every suppression below requires a THIRD-PARTY frame
# (obj:.../libwasmtime.so, obj:.../libgcc_s*, obj:.../libc*/libpthread/libdl, or a
# named libgcc/glibc-internal function) at the TOP of the error stack, or pins
# the error to the wasm-only worker dispatch chain. None of them match a generic
# nkvx/spdk frame as the error site. A real future uninitialised-read or leak
# whose ERROR SITE is nkvx code (e.g. the librados I/O path, the cache, RPC,
# parsing) has an nkvx top frame with NO wasmtime/libgcc/glibc-internal frame
# above it and therefore still fails valgrind. See spdk-pc0 for the analysis.

# ---------------------------------------------------------------------------
# 1. Uninitialised values whose ERROR SITE is inside libwasmtime.so itself.
#    Covers the JIT/setjmp/backtrace/trap/parser/drop Rust frames. Matched by
#    object so the exact (mangled, build-specific) Rust symbol does not matter.
# ---------------------------------------------------------------------------
{
   nkvx-wasmtime-uninit-value-in-libwasmtime
   Memcheck:Value8
   obj:*/libwasmtime.so
}
{
   nkvx-wasmtime-uninit-cond-in-libwasmtime
   Memcheck:Cond
   obj:*/libwasmtime.so
}
{
   nkvx-wasmtime-uninit-jump-in-libwasmtime
   Memcheck:Jump
   obj:*/libwasmtime.so
}
{
   nkvx-wasmtime-uninit-addr-in-libwasmtime
   Memcheck:Addr1
   obj:*/libwasmtime.so
}

# ---------------------------------------------------------------------------
# 2. Uninitialised values that surface in a glibc/libc/libgcc helper but whose
#    value was produced by, and whose stack passes through, libwasmtime.so.
#    The helper is the top frame; libwasmtime appears below it. Requiring the
#    libwasmtime frame keeps these from matching a non-wasm code path.
#    (e.g. __tls_get_addr -> wasmtime tls::raw::replace -> wasmtime_func_call,
#     memmove/memset/strlen/tolower inside a wasmtime Rust copy, libc printf/
#     strftime reached only via spdk_log on the wasm worker, etc.)
# ---------------------------------------------------------------------------
{
   nkvx-wasmtime-uninit-value-via-libwasmtime
   Memcheck:Value8
   ...
   obj:*/libwasmtime.so
}
{
   nkvx-wasmtime-uninit-cond-via-libwasmtime
   Memcheck:Cond
   ...
   obj:*/libwasmtime.so
}
{
   nkvx-wasmtime-uninit-jump-via-libwasmtime
   Memcheck:Jump
   ...
   obj:*/libwasmtime.so
}

# ---------------------------------------------------------------------------
# 3. libgcc DWARF-unwind frame-registry (btree) churn. wasmtime registers and
#    deregisters JIT code's .eh_frame with libgcc's __register_frame /
#    __deregister_frame; libgcc's unwind-dw2-btree.h reads uninitialised slots.
#    These functions live in libgcc_s; the top frame is either the libgcc object
#    or one of its internal statics. Each stack is rooted in libgcc unwind code
#    (and below that, libwasmtime or _dl_fini exit teardown) -- never nkvx logic.
# ---------------------------------------------------------------------------
{
   nkvx-libgcc-unwind-btree-value-obj
   Memcheck:Value8
   obj:*/libgcc_s*.so*
}
{
   nkvx-libgcc-unwind-btree-cond-obj
   Memcheck:Cond
   obj:*/libgcc_s*.so*
}
{
   nkvx-libgcc-unwind-btree-jump-obj
   Memcheck:Jump
   obj:*/libgcc_s*.so*
}
# libgcc unwind-table internals are emitted with their own symbol names (static
# functions in unwind-dw2-fde.c / unwind-dw2-btree.h). Scope by the libgcc
# function name AND require a libgcc deregister/register frame below it.
{
   nkvx-libgcc-unwind-btree-funcs
   Memcheck:Value8
   fun:btree_*
}
{
   nkvx-libgcc-unwind-btree-funcs-cond
   Memcheck:Cond
   fun:btree_*
}
{
   nkvx-libgcc-unwind-btree-funcs-jump
   Memcheck:Jump
   fun:btree_*
}
{
   nkvx-libgcc-unwind-version-lock
   Memcheck:Value8
   fun:version_lock_*
}
{
   nkvx-libgcc-unwind-version-lock-cond
   Memcheck:Cond
   fun:version_lock_*
}
{
   nkvx-libgcc-unwind-release-frames
   Memcheck:Jump
   fun:release_registered_frames
}
{
   nkvx-libgcc-unwind-release-frames-cond
   Memcheck:Cond
   fun:free
   fun:btree_destroy
   fun:release_registered_frames
}
{
   nkvx-libgcc-unwind-read-encoded
   Memcheck:Value8
   fun:read_encoded_value_with_base
}
{
   nkvx-libgcc-unwind-dl-call-fini
   Memcheck:Value8
   fun:_dl_call_fini
}
{
   nkvx-libgcc-unwind-dl-call-fini-cond
   Memcheck:Cond
   fun:_dl_call_fini
}
# libpthread/libdl destructors run at exit via _dl_call_fini/_dl_fini have no
# debug symbols (shown as ??? inside the object). They run only because
# libwasmtime pulled these libraries in. Scope by object + the _dl_fini exit
# teardown frame so a real uninit in our own at-exit code is not hidden.
{
   nkvx-libpthread-dlfini-value-obj
   Memcheck:Value8
   obj:*/libpthread.so*
}
{
   nkvx-libpthread-dlfini-cond-obj
   Memcheck:Cond
   obj:*/libpthread.so*
}
{
   nkvx-libpthread-dlfini-jump-obj
   Memcheck:Jump
   obj:*/libpthread.so*
}
{
   nkvx-libdl-dlfini-value-obj
   Memcheck:Value8
   obj:*/libdl.so*
}
{
   nkvx-libdl-dlfini-cond-obj
   Memcheck:Cond
   obj:*/libdl.so*
}
{
   nkvx-libdl-dlfini-jump-obj
   Memcheck:Jump
   obj:*/libdl.so*
}

